[importlinter]
root_package = ffmodel
include_external_packages = True

[importlinter:contract:core-independent]
name = Core must not import adapters or nba_api (Constitution VI)
type = forbidden
source_modules =
    ffmodel.core
forbidden_modules =
    ffmodel.adapters
    nba_api

[importlinter:contract:adapters-independent]
name = Adapters must not import core (Constitution VI)
type = forbidden
source_modules =
    ffmodel.adapters
forbidden_modules =
    ffmodel.core

[importlinter:contract:contract-is-base]
name = Contract imports neither adapters nor core
type = forbidden
source_modules =
    ffmodel.contract
forbidden_modules =
    ffmodel.adapters
    ffmodel.core

[importlinter:contract:core-not-tools]
name = Core must not import tools or api (Constitution VII)
type = forbidden
source_modules =
    ffmodel.core
forbidden_modules =
    ffmodel.tools
    ffmodel.api

[importlinter:contract:tools-not-api]
name = Tools must not import api or adapters (Constitution VII)
type = forbidden
source_modules =
    ffmodel.tools
forbidden_modules =
    ffmodel.api
    ffmodel.adapters

[importlinter:contract:adapters-not-tools]
name = Adapters must not import tools or api
type = forbidden
source_modules =
    ffmodel.adapters
forbidden_modules =
    ffmodel.tools
    ffmodel.api

[importlinter:contract:tools-independent]
name = Tools must not import each other (Constitution VII)
type = independence
modules =
    ffmodel.tools.impact_analysis
    ffmodel.tools.player_analysis
